#!/usr/bin/env bash
# Everything that must be true before a commit, and nothing that needs a
# daemon, a network or a tty. CI runs this too.
#
#   bin/lint
#
# For the heavier gates — the build and the CDC replay — see bin/check.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"

echo '── typecheck'
npx tsc --noEmit

echo
echo '── no strays'
bin/no-strays

echo
# --no-site: the registry checks, without needing a python toolchain to build
# the site. The docs workflow does the full build, where a broken internal
# link fails mkdocs --strict.
bin/gen-docs --check --no-site

echo
echo 'ok'
