#!/usr/bin/env bash
# The chart's CRDs, generated from the Rust types in deploy/crds.
#
#   bin/gen-crds          # write deploy/chart/crds/crds.yaml
#   bin/gen-crds --check  # write nothing; fail if the chart's copy is stale
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
out="$root/deploy/chart/crds/crds.yaml"
header='# Generated by bin/gen-crds from deploy/crds — do not edit by hand.'

generated="$(cd "$root/deploy" && cargo run --quiet -p coli-crds --bin gen-crds)"
want="$(printf '%s\n%s' "$header" "$generated")"

if [[ "${1:-}" == "--check" ]]; then
  if [[ ! -f "$out" ]] || [[ "$(cat "$out")" != "$want" ]]; then
    echo "deploy/chart/crds/crds.yaml is out of date with deploy/crds — run bin/gen-crds" >&2
    exit 1
  fi
  echo "crds: current"
  exit 0
fi

mkdir -p "$(dirname "$out")"
printf '%s\n' "$want" > "$out"
echo "wrote ${out#"$root"/}"
