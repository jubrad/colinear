node_modules/
dist/
clo-views-export.json

# bin/gen-docs output: staged sources and the built site
site-src/
site/

# bin/gen-docs provisions this when mkdocs-material is not already available
.venv-docs/

# playwright-mcp scratch output (screenshot/driving sessions)
.playwright-mcp/

# Backup archives — `coli backup` writes one wherever you run it, and running
# it from the checkout is the obvious thing to do. They hold session
# transcripts, git bundles of unpushed work and whatever is in your config.
coli-backup-*.tar.gz
*.tar.gz
*.tgz

# An unset variable expands to nothing, so "${DIR}/tmp/x" writes ./undefined/…
# right here. bin/no-strays fails on these too, in case one is force-added.
undefined/
