{
  "name": "colinear",
  "version": "0.2.0",
  "description": "A k9s-style TUI that runs Claude Code agents against your issue tracker: pick issues, dispatch agents, watch the board",
  "type": "module",
  "bin": {
    "colinear": "dist/index.js",
    "coli": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.tsx",
    "doctor": "tsx src/doctor.ts",
    "build": "tsc && chmod +x dist/index.js",
    "typecheck": "tsc --noEmit",
    "check": "tsx src/core/store.check.ts",
    "check:worktrees": "tsx src/core/worktrees.check.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.221",
    "ink": "^5.0.1",
    "ink-text-input": "^6.0.0",
    "react": "^18.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jubrad/colinear.git"
  },
  "homepage": "https://github.com/jubrad/colinear#readme",
  "bugs": {
    "url": "https://github.com/jubrad/colinear/issues"
  },
  "keywords": [
    "claude",
    "claude-code",
    "agents",
    "linear",
    "tui",
    "ink",
    "kanban"
  ]
}
